FROM node:22-bookworm-slim AS node

FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl wget libgomp1 tini \
    && (apt-get install -y --no-install-recommends libnccl2 || true) \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node

ARG LLAMA_URL=https://github.com/ai-dock/llama.cpp-cuda/releases/download/v1.0.0/llama.cpp-v1.0.0-cuda-12.8-amd64.tar.gz
ENV PATH=/opt/llama/cuda-12.8:$PATH \
    LD_LIBRARY_PATH=/opt/llama/cuda-12.8:$LD_LIBRARY_PATH
RUN mkdir -p /opt/llama \
    && cd /opt/llama \
    && wget -q "$LLAMA_URL" -O llama.tar.gz \
    && tar xzf llama.tar.gz \
    && rm -f llama.tar.gz \
    && test -x cuda-12.8/llama-server \
    && test -f cuda-12.8/libmtmd.so.1.0.0 \
    && missing="$(ldd cuda-12.8/llama-server cuda-12.8/libllama-server-impl.so cuda-12.8/libggml-cuda.so.1.0.0 2>/dev/null | grep 'not found' | grep -v 'libcuda.so.1' || true)" \
    && if [ -n "$missing" ]; then echo "unresolved: $missing" && exit 1; fi

WORKDIR /app
COPY proxy/server.mjs /app/server.mjs
COPY cloud/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8080 8000
ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
